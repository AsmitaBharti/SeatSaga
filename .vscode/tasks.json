{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-inventory-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Services/Inventory/Inventory.Api/Inventory.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch-inventory-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/Services/Inventory/Inventory.Api/Inventory.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "add-migration",
      "command": "dotnet",
      "type": "process",
      "args": [
        "ef",
        "migrations",
        "add",
        "${input:migrationName}",
        "--project",
        "${workspaceFolder}/src/Services/Inventory/Inventory.Api/Inventory.Api.csproj"
      ],
      "problemMatcher": []
    },
    {
      "label": "compose-up",
      "command": "docker",
      "type": "process",
      "args": ["compose", "up", "--build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Migration name (e.g. InitialCreate)"
    }
  ]
}
